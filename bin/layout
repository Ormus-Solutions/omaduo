#!/usr/bin/env bash
# Zenbook Duo UX8406CA layout for Hyprland/Omarchy.
# Magnetic keyboard USB 0b05:1bf2 sits on the bottom panel:
#   attached  -> disable eDP-2
#   detached  -> stack eDP-2 under eDP-1 (or side-by-side when portrait)
set -euo pipefail
BIN_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

SCALE=1.5
# 1200 / 1.5 = 800 logical px (landscape height, portrait width)
BOTTOM_Y=800
PORTRAIT_W=800
SCREENPAD=/sys/class/backlight/asus_screenpad/brightness
BT_MAC_FILE="${HOME}/.config/moon-duo/bt-keyboard.mac"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/toggles"
ROTATE_FLAG="$STATE_DIR/duo-rotate"
ROTATE_DIR="$STATE_DIR/duo-rotate.dir"

hypr_ready() {
  export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" && -d "${XDG_RUNTIME_DIR}/hypr" ]]; then
    local d
    d=$(find "${XDG_RUNTIME_DIR}/hypr" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | head -1 || true)
    [[ -n "$d" ]] && export HYPRLAND_INSTANCE_SIGNATURE="${d##*/}"
  fi
  [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]
}

hypr() {
  hypr_ready || return 1
  hyprctl eval "$1" >/dev/null
}

keyboard_on() {
  local d
  for d in /sys/bus/usb/devices/*; do
    [[ -f "$d/idVendor" && -f "$d/idProduct" ]] || continue
    [[ $(<"$d/idVendor") == 0b05 ]] || continue
    [[ $(<"$d/idProduct") == 1bf2 ]] || continue
    return 0
  done
  return 1
}

set_screenpad() {
  local val=$1
  [[ -e "$SCREENPAD" ]] || return 0
  echo "$val" | sudo -n tee "$SCREENPAD" >/dev/null 2>&1 || true
}

# 0 = landscape stacked. 1 = 90° CW (left-up). 3 = 270° CW (right-up).
portrait_transform() {
  if [[ ! -f "$ROTATE_FLAG" ]]; then
    echo 0
    return
  fi
  local t
  t=$(<"$ROTATE_DIR" 2>/dev/null || true)
  if [[ "$t" == "1" || "$t" == "3" ]]; then
    echo "$t"
    return
  fi
  echo 1
}

monitor_eval() {
  local output=$1 position=$2 transform=$3
  hypr "hl.monitor({ output = \"${output}\", mode = \"1920x1200@60\", position = \"${position}\", scale = ${SCALE}, transform = ${transform}, disabled = false })" || true
}

apply() {
  hypr_ready || return 0
  local t
  t=$(portrait_transform)
  hypr 'hl.monitor({ output = "", mode = "preferred", position = "auto", scale = "auto" })' || true

  if keyboard_on; then
    monitor_eval eDP-1 "0x0" "$t"
    hypr 'hl.monitor({ output = "eDP-2", disabled = true })' || true
    set_screenpad 0
    return 0
  fi

  case "$t" in
    1)
      # Device left-up: original bottom (eDP-2) is left, lid (eDP-1) is right.
      monitor_eval eDP-2 "0x0" 1
      monitor_eval eDP-1 "${PORTRAIT_W}x0" 1
      ;;
    3)
      # Device right-up: lid (eDP-1) is left, original bottom (eDP-2) is right.
      monitor_eval eDP-1 "0x0" 3
      monitor_eval eDP-2 "${PORTRAIT_W}x0" 3
      ;;
    *)
      monitor_eval eDP-1 "0x0" 0
      monitor_eval eDP-2 "0x${BOTTOM_Y}" 0
      ;;
  esac

  "$BIN_DIR/brightness-mirror" once >/dev/null 2>&1 || true
  rfkill unblock bluetooth >/dev/null 2>&1 || true
  if [[ -s "$BT_MAC_FILE" ]]; then
    "$BIN_DIR/bt-connect" >/dev/null 2>&1 &
  fi
}

watch() {
  local prev cur
  apply || true
  if keyboard_on; then prev=on; else prev=off; fi
  udevadm monitor --udev --subsystem-match=usb | while IFS= read -r _; do
    sleep 0.3
    if keyboard_on; then cur=on; else cur=off; fi
    [[ "$cur" == "$prev" ]] && continue
    prev=$cur
    apply || true
  done
}

case "${1:-apply}" in
  apply) apply ;;
  watch) watch ;;
  status)
    if keyboard_on; then echo keyboard=attached; else echo keyboard=detached; fi
    echo transform="$(portrait_transform)"
    hypr_ready && hyprctl monitors | grep -E 'Monitor |disabled:|scale:|transform:| at ' || true
    ;;
  *) echo "usage: $0 apply|watch|status" >&2; exit 1 ;;
esac
